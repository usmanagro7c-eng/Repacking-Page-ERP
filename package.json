{
  "name": "erp-forms",
  "version": "1.0.0",
  "private": true,
  "description": "ERP Forms Monorepo — Unified Gatepass & Repacking / Production Form Portal with ERPNext & MCP",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "mcp": "npm run mcp --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
