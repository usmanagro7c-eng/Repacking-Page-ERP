# Express Server Port
PORT=5000

# ERPNext Connection Configuration
ERPNEXT_URL=http://localhost:8000
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# Target ERPNext Doctype to create/sync (e.g., Stock Entry, Work Order, or Custom Doctype)
ERPNEXT_DOCTYPE=Stock Entry
